# PostgreSQL-first community configuration.
# The SQLite path is retained only for read-only import/rollback work;
# see docs/deployment.md.

# ================= Telegram API =================
# Get both at https://my.telegram.org -> "API development tools"
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# One-time login string. Generate with:  python scripts/generate_session.py
SESSION_STRING=

# ================= Channels =================
# Comma separated. @username, https://t.me/name or numeric id (-100...)
CHANNELS=@my_channel

# ================= Web admin panel =================
# Keep 127.0.0.1 locally; on Hetzner use 0.0.0.0 behind a reverse proxy
WEB_HOST=127.0.0.1
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional fixed cookie secret; auto-generated into data/.secret if empty
SESSION_SECRET=
# Set true when behind a TLS-terminating reverse proxy (Caddy/nginx) to enable Secure cookies and HSTS.
BEHIND_TLS=false
# Trusted proxy IPs for X-Forwarded-For (e.g. 127.0.0.1, 10.0.0.1 or *); empty disables proxy header trust.
TRUSTED_PROXY_IPS=
# Process topology: all (community default), web, or worker (hosted split).
PROCESS_ROLE=all
STUDIO_ENABLED=false
# Optional M0.6 provider smoke test; never put this key in the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# M2 deterministic local agent tests only; keep false in real deployments.
STUDIO_TEST_MODE=false
STUDIO_PROVIDER_TIMEOUT_SECONDS=45
STUDIO_RUN_TIMEOUT_SECONDS=300
STUDIO_RUN_CONCURRENCY=2
STUDIO_RUN_LEASE_SECONDS=120
STUDIO_RUN_HEARTBEAT_SECONDS=20
STUDIO_QUEUED_RUN_GRACE_SECONDS=60
STUDIO_TOOL_TIMEOUT_SECONDS=30
STUDIO_TOOL_CONCURRENCY=6
STUDIO_MAX_TOOL_CALLS=12
STUDIO_MAX_OUTPUT_TOKENS=8192
STUDIO_CONTEXT_MAX_CHARS=18000
STUDIO_MAX_EVIDENCE_POSTS=20
STUDIO_MIN_PROFILE_POSTS=5
# M4 research (optional; use only a private SearXNG instance)
STUDIO_SEARCH_ENABLED=false
STUDIO_SEARCH_PROVIDER=searxng
# Optional image tag or digest; pin this in a hosted deployment.
SEARXNG_IMAGE=searxng/searxng:latest
# In Compose with --profile studio-search, use http://searxng:8080
STUDIO_SEARCH_BASE_URL=
STUDIO_SEARCH_TIMEOUT_SECONDS=10
STUDIO_SEARCH_RETRIES=1
# Fallback and allowed SearXNG engines. The Studio agent chooses a bounded
# subset for each search plan; users do not need to configure search filters.
STUDIO_SEARCH_ENGINES=yandex,github,arxiv,wikipedia
STUDIO_SEARCH_ALLOWED_ENGINES=yandex,github,arxiv,wikipedia,bing,bing news,google,google news,brave,brave news,mojeek,qwant
# Optional deployment policy; empty by default. Agent chooses exclusions per request.
STUDIO_SEARCH_BLOCKED_DOMAINS=
STUDIO_SEARCH_MAX_QUERIES=12
STUDIO_SEARCH_MAX_RESULTS=10
STUDIO_SEARCH_CACHE_TTL_SECONDS=900
STUDIO_SOURCE_READER_ENABLED=true
STUDIO_SOURCE_TIMEOUT_SECONDS=10
STUDIO_SOURCE_MAX_BYTES=1000000
STUDIO_SOURCE_MAX_REDIRECTS=3
STUDIO_SOURCE_MAX_CHARS=12000

# ================= Telegram admin commands =================
# Your numeric user id(s), comma separated.
# Not sure about your id? Send /whoami to yourself in Saved Messages once the bot runs.
ADMIN_TG_IDS=

# ================= Collection tuning =================
POLL_MINUTES=15
# Set both values to 0 to collect the complete channel history.
TRACK_DAYS=30
BACKFILL_LIMIT=200

# ================= Storage =================
DATA_DIR=data
# M1 PostgreSQL runtime (leave blank only while using the legacy SQLite mode)
# Docker services use the internal hostname below. Host-side Alembic/scripts
# can temporarily override DATABASE_URL with 127.0.0.1:55432.
# The tg_stats database and role names are retained for existing installations.
# DATABASE_URL=postgresql+asyncpg://tg_stats:change-me@postgres:5432/tg_stats
DATABASE_URL=
POSTGRES_DB=tg_stats
POSTGRES_USER=tg_stats
POSTGRES_PASSWORD=change-me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=55432
APP_MODE=community
LOCAL_WORKSPACE_SLUG=community
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Generate with: python scripts/generate_session_key.py
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_CONNECTION_LABEL=default
