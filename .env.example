# PostgreSQL-first community configuration.
# The SQLite path is retained only for read-only import/rollback work;
# see docs/deployment.md.

# ================= Telegram API =================
# Get both at https://my.telegram.org -> "API development tools"
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# One-time login string. Generate with:  python scripts/generate_session.py
SESSION_STRING=

# ================= Channels =================
# Comma separated. @username, https://t.me/name or numeric id (-100...)
CHANNELS=@my_channel

# ================= Web admin panel =================
# Keep 127.0.0.1 locally; on Hetzner use 0.0.0.0 behind a reverse proxy
WEB_HOST=127.0.0.1
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional fixed cookie secret; auto-generated into data/.secret if empty
SESSION_SECRET=
# Set true when behind a TLS-terminating reverse proxy (Caddy/nginx) to enable Secure cookies and HSTS.
BEHIND_TLS=false
# Trusted proxy IPs for X-Forwarded-For (e.g. 127.0.0.1, 10.0.0.1 or *); empty disables proxy header trust.
TRUSTED_PROXY_IPS=
# Process topology: all (community default), web, or worker (hosted split).
PROCESS_ROLE=all
# Provider settings; never put the key in the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# M4 research (optional; use only a private SearXNG instance)
STUDIO_SEARCH_ENABLED=false
# Optional image tag or digest; pin this in a hosted deployment.
SEARXNG_IMAGE=searxng/searxng:latest
# In Compose with --profile studio-search, use http://searxng:8080
STUDIO_SEARCH_BASE_URL=
# Optional deployment policy; empty by default. Agent chooses exclusions per request.
STUDIO_SEARCH_BLOCKED_DOMAINS=

# ================= Collection tuning =================
POLL_MINUTES=15
# Set both values to 0 to collect the complete channel history.
TRACK_DAYS=30
BACKFILL_LIMIT=200

# ================= Storage =================
DATA_DIR=data
# M1 PostgreSQL runtime (leave blank only while using the legacy SQLite mode)
# Docker services use the internal hostname below. Host-side Alembic/scripts
# can temporarily override DATABASE_URL with 127.0.0.1:55432.
# The tg_stats database and role names are retained for existing installations.
# DATABASE_URL=postgresql+asyncpg://tg_stats:change-me@postgres:5432/tg_stats
DATABASE_URL=
POSTGRES_DB=tg_stats
POSTGRES_USER=tg_stats
POSTGRES_PASSWORD=change-me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=55432
# Generate with: python scripts/generate_session_key.py
TELEGRAM_SESSION_ENCRYPTION_KEY=
